# AI 模型服务（必填）
# 在火山方舟控制台创建推理接入点后，填写 API Key、基础地址和 Endpoint ID。
ARK_API_KEY=replace-with-your-ark-api-key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=replace-with-your-ark-chat-endpoint-id
ARK_EMBEDDING_MODEL=replace-with-your-ark-embedding-model-id

# 本地网关治理（推荐配置）
# 仅用于本机服务台管理，不要提交真实值。
GATEWAY_ADMIN_API_KEY=replace-with-a-long-local-admin-secret

# LLM Service 与内部 MCP 服务网关之间的服务间凭证。
# 未单独配置时，Demo 会兼容使用 GATEWAY_ADMIN_API_KEY；生产环境应使用独立密钥。
LLM_INTERNAL_STREAM_KEY=replace-with-a-service-to-service-secret

# 网关服务台连接配置（通常无需修改）。
# GATEWAY_CONSOLE_API_KEY 必须与 gateway/config.yaml 中对应项目的 API Key 保持一致。
GATEWAY_BASE_URL=http://127.0.0.1:8000
GATEWAY_CONSOLE_API_KEY=xzy-odm-report-agent-key

# 可选：第二个 OpenAI 兼容模型 Endpoint，用于主备路由演示。
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=replace-with-your-deepseek-model-name
