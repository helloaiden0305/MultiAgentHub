# 豆包（火山引擎 ARK）API 配置
ARK_API_KEY=your-ark-api-key-here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# 豆包模型 Endpoint ID（在火山引擎控制台创建推理接入点后获得）
ARK_CHAT_MODEL=your-chat-endpoint-id
ARK_EMBEDDING_MODEL=doubao-embedding-vision-250615

# 网关服务台管理员密钥（可选）
# 配置后，8500 服务台可管理 Endpoint、逻辑路由、项目配额与订阅；
# 未配置时服务台保持只读。仅放在本地 .env，不能提交到 GitHub。
GATEWAY_ADMIN_API_KEY=replace-with-a-local-admin-secret

# DeepSeek OpenAI 兼容接入（可选第二 Endpoint）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
